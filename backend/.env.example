# URL de conexão com o banco de dados PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgresql://user:password@localhost:5432/simulador"

# Chave secreta usada para assinar e verificar tokens JWT
# Use uma string longa e aleatória em produção (ex: openssl rand -hex 64)
# Gere com: node -e "require('crypto').randomBytes(64).toString('hex')" | xargs echo
JWT_SECRET="gere-uma-chave-aleatoria-com-openssl-rand-hex-64"

# Porta em que o servidor Express irá escutar (padrão: 3333)
PORT=3333

# Origens permitidas pelo CORS (separadas por vírgula)
ALLOWED_ORIGINS="http://localhost:5173"

# Ambiente de execução: development | production | test
NODE_ENV=development
