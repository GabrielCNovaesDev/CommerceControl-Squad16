generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GAME_MASTER
  PLAYER
  OBSERVER
}

enum RoundStatus {
  OPEN
  PROCESSING
  CLOSED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(PLAYER)
  leader    Boolean  @default(false)
  squadId   String?
  createdAt DateTime @default(now())

  squad Squad? @relation(fields: [squadId], references: [id])
}

model Squad {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  stores Store[]
}

model Store {
  id             String   @id @default(uuid())
  name           String
  initialCapital Float
  squadId        String
  createdAt      DateTime @default(now())

  squad            Squad             @relation(fields: [squadId], references: [id])
  inventories      Inventory[]
  roundConfigs     RoundConfig[]
  financialResults FinancialResult[]
}

model Product {
  id            String   @id @default(uuid())
  name          String
  purchasePrice Float
  taxRate       Float    @default(0)
  breakageRate  Float    @default(0)
  agingRate     Float    @default(0)
  mixAvailable  Int      @default(0)
  createdAt     DateTime @default(now())

  inventories      Inventory[]
  roundConfigItems RoundConfigItem[]
}

model Inventory {
  id        String @id @default(uuid())
  storeId   String
  productId String
  quantity  Int

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([storeId, productId])
}

model Round {
  id           String      @id @default(uuid())
  number       Int
  startDate    DateTime
  endDate      DateTime
  status       RoundStatus @default(OPEN)
  demandFactor Float       @default(0.5)

  roundConfigs     RoundConfig[]
  financialResults FinancialResult[]
}

model RoundConfig {
  id                String   @id @default(uuid())
  roundId           String
  storeId           String
  otherExpenses     Float    @default(0)
  cashierOperators  Int      @default(10)
  serviceOperators  Int      @default(5)
  quizScore         Float    @default(1.0)
  submittedAt       DateTime @default(now())

  round            Round             @relation(fields: [roundId], references: [id])
  store            Store             @relation(fields: [storeId], references: [id])
  roundConfigItems RoundConfigItem[]
  financialResult  FinancialResult?

  @@unique([roundId, storeId])
}

model RoundConfigItem {
  id            String @id @default(uuid())
  roundConfigId String
  productId     String
  margin        Float
  salesVolume   Int

  roundConfig RoundConfig @relation(fields: [roundConfigId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@unique([roundConfigId, productId])
}

model FinancialResult {
  id             String   @id @default(uuid())
  roundId        String
  storeId        String
  roundConfigId  String   @unique
  grossRevenue   Float
  taxes          Float
  netRevenue     Float
  costs          Float
  grossMargin    Float
  totalBreakage  Float
  totalAging     Float
  netMarginMass  Float
  otherExpenses  Float
  ebitda         Float
  ebitdaMargin   Float
  demandShare    Float    @default(0)
  calculatedAt   DateTime @default(now())

  round       Round       @relation(fields: [roundId], references: [id])
  store       Store       @relation(fields: [storeId], references: [id])
  roundConfig RoundConfig @relation(fields: [roundConfigId], references: [id])
}
