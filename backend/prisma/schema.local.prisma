generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client-local"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("PLAYER")
  cargo     String?
  leader    Boolean  @default(false)
  squadId   String?
  createdAt DateTime @default(now())
  squad     Squad?   @relation(fields: [squadId], references: [id], onDelete: SetNull)
}

model Squad {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stores    Store[]
  users     User[]
}

model Store {
  id               String            @id @default(uuid())
  name             String
  initialCapital   Float
  currentCash      Float
  squadId          String
  createdAt        DateTime          @default(now())
  financialResults FinancialResult[]
  inventories      Inventory[]
  roundConfigs     RoundConfig[]
  events           RoundEvent[]
  squad            Squad             @relation(fields: [squadId], references: [id], onDelete: Cascade)
}

model Product {
  id               String            @id @default(uuid())
  name             String
  purchasePrice    Float
  taxRate          Float             @default(0.0)
  breakageRate     Float             @default(0.0)
  agingRate        Float             @default(0.0)
  mixAvailable     Int               @default(1000)
  createdAt        DateTime          @default(now())
  inventories      Inventory[]
  roundConfigItems RoundConfigItem[]
}

model Inventory {
  id        String  @id @default(uuid())
  storeId   String
  productId String
  quantity  Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
}

model Round {
  id               String            @id @default(uuid())
  number           Int
  durationHours    Int               @default(1)
  demandFactor     Float             @default(0.5)
  endsAt           DateTime
  status           String            @default("OPEN")
  aiReportGm       String?
  createdAt        DateTime          @default(now())
  financialResults FinancialResult[]
  roundConfigs     RoundConfig[]
  events           RoundEvent[]
}

model RoundConfig {
  id                String            @id @default(uuid())
  roundId           String
  storeId           String
  otherExpenses     Float             @default(0)
  cashierOperators  Int               @default(10)
  serviceOperators  Int               @default(5)
  quizScore         Float             @default(1.0)
  numPdvs           Int               @default(6)
  capexSeguranca    Boolean           @default(false)
  capexBalanca      Boolean           @default(false)
  capexRedes        Boolean           @default(false)
  capexSite         Boolean           @default(false)
  capexSelfCheckout Boolean           @default(false)
  capexMelhoria     Boolean           @default(false)
  submittedAt       DateTime          @default(now())
  financialResult   FinancialResult?
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  round             Round             @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundConfigItems  RoundConfigItem[]

  @@unique([roundId, storeId])
}

model RoundConfigItem {
  id            String      @id @default(uuid())
  roundConfigId String
  productId     String
  margin        Float
  salesVolume   Int
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  roundConfig   RoundConfig @relation(fields: [roundConfigId], references: [id], onDelete: Cascade)

  @@unique([roundConfigId, productId])
}

model FinancialResult {
  id            String      @id @default(uuid())
  roundId       String
  storeId       String
  roundConfigId String      @unique
  grossRevenue  Float
  taxes         Float
  netRevenue    Float
  costs         Float
  grossMargin   Float
  totalBreakage Float
  totalAging    Float
  netMarginMass Float
  otherExpenses Float
  ebitda        Float
  ebitdaMargin  Float
  demandShare   Float       @default(0)
  priceScore    Int?
  availScore    Int?
  csatScore     Int?
  totalScore    Int?
  aiReport      String?
  calculatedAt  DateTime    @default(now())
  roundConfig   RoundConfig @relation(fields: [roundConfigId], references: [id], onDelete: Cascade)
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  round         Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
}

model GameSettings {
  id                    String   @id @default("singleton")
  licenseSoPerUser      Float    @default(120)
  licenseSoUsers        Int      @default(5)
  licensePdvPerUnit     Float    @default(80)
  licenseScoPerUnit     Float    @default(80)
  licenseScoUnits       Int      @default(4)
  licenseSiteBase       Float    @default(500)
  licenseSiteCapex      Float    @default(650)
  licenseSecurityBase   Float    @default(500)
  licenseSecurityCapex  Float    @default(600)
  maintenanceFee        Float    @default(400)
  updatedAt             DateTime @updatedAt
}

model RoundEvent {
  id          String   @id @default(uuid())
  roundId     String
  storeId     String
  eventKey    String
  description String
  penalty     Float
  mitigated   Boolean  @default(false)
  createdAt   DateTime @default(now())

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}
