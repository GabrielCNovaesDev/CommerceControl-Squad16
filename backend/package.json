{
  "name": "backend",
  "version": "1.0.0",
  "description": "Simulador Estratégico de Loja - Cencosud",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:local": "dotenv -e .env.local -- nodemon src/server.js",
    "setup:local": "prisma generate --schema=prisma/schema.local.prisma && dotenv -e .env.local -- prisma db push --schema=prisma/schema.local.prisma && dotenv -e .env.local -- node prisma/seed.js",
    "migrate": "prisma migrate dev",
    "seed": "node prisma/seed.js",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "jest-mock-extended": "^4.0.0",
    "dotenv-cli": "^7.4.4",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2"
  }
}
