{
  "name": "backend",
  "version": "1.0.0",
  "description": "Simulador Estratégico de Loja - Cencosud",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node -r tsconfig-paths/register src/server.ts",
    "dev:local": "dotenv -e .env.local -- ts-node --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "tsc",
    "setup:local": "node scripts/create-env-local.js && node scripts/clean-prisma-local.js && cross-env DATABASE_URL=file:./local.db prisma generate --schema=prisma/schema.local.prisma && cross-env DATABASE_URL=file:./local.db prisma db push --schema=prisma/schema.local.prisma --force-reset --skip-generate && cross-env DATABASE_URL=file:./local.db node prisma/seed.local.js",
    "migrate": "prisma migrate dev",
    "seed": "node prisma/seed.js",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@prisma/client-local": "file:./node_modules/.prisma/client-local",
    "bcryptjs": "^3.0.3",
    "commercecontrol-squad16": "file:..",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.42.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^7.4.4",
    "jest": "^30.3.0",
    "jest-mock-extended": "^4.0.0",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
